# ==============================================================================
# OmniFeed Environment Variables
# ==============================================================================

# Apify API Credentials (Instagram & Social Scraping)
APIFY_API_TOKEN=your_apify_api_token_here

# Bright Data API Credentials (Web Unlocker / Scraping API)
# Get your API key and Zone name from: https://brightdata.com/cp/zones
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Optional: Host / Port
PORT=3000
